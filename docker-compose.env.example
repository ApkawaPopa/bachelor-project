ADDRESS=localhost # address of application

BACKEND_SHOW_SQL=false # SQL showing for hibernate
BACKEND_FORMAT_SQL=false # SQL formatting for hibernate
BACKEND_LOGGING_LEVEL=OFF # logs configuration
BACKEND_JWT_SECRET= # JWT signing secret

POSTGRES_PORT=5432 # pg database port for external connection
POSTGRES_DB=amina_db # pg database name
POSTGRES_USER=amina_user # pg database owner name
POSTGRES_PASSWORD=amina_password # pg database owner password

S3_ROOT_USER=amina_user # credentials for s3 console
S3_ROOT_PASSWORD=amina_password # credentials for s3 console
S3_ACCESS_KEY=access_key # credentials for backend to use s3
S3_SECRET_KEY=secret_key # credentials for backend to use s3
S3_BUCKET=amina-data # name of s3 bucket

BROKER_LOGIN=broker_login # login for stomp message broker
BROKER_PASSCODE=broker_passcode # passcode for stomp message broker